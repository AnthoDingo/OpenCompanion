<Page x:Class="TeamsCompanion.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:TeamsCompanion">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">
            <ui:TextBlock Text="{Binding [NavSettings], Source={x:Static local:Tr.I}}" FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16" />

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <ui:TextBlock Text="{Binding [Language], Source={x:Static local:Tr.I}}" FontTypography="BodyStrong" />
                    <ui:TextBlock Text="{Binding [LanguageHint], Source={x:Static local:Tr.I}}" Margin="0,2,0,8"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="LangBox" Width="200" HorizontalAlignment="Left"
                              DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectionChanged="Lang_Changed" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <ui:TextBlock Text="{Binding [AppUpdate], Source={x:Static local:Tr.I}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:InfoBar x:Name="AppBar" IsOpen="True" IsClosable="False" />
                    <ui:Button x:Name="AppUpdateButton" Appearance="Primary" Margin="0,8,0,0"
                               Visibility="Collapsed" Click="AppUpdate_Click" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <ui:TextBlock Text="{Binding [FirmwareUpdate], Source={x:Static local:Tr.I}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:InfoBar x:Name="Device" IsOpen="True" IsClosable="False" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button x:Name="UpdateButton" Appearance="Primary" Margin="0,0,8,0"
                                   Visibility="Collapsed" Click="Update_Click" />
                        <ui:Button x:Name="FileButton" Content="{Binding [FirmwareFile], Source={x:Static local:Tr.I}}"
                                   Visibility="Collapsed" Click="File_Click" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <ui:TextBlock Text="{Binding [Detection], Source={x:Static local:Tr.I}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DetectClient" Content="{Binding [DetectionClient], Source={x:Static local:Tr.I}}"
                                     GroupName="Detection" IsChecked="True" Margin="0,0,24,0" Checked="Detection_Checked" />
                        <RadioButton x:Name="DetectGraph" Content="{Binding [DetectionGraph], Source={x:Static local:Tr.I}}"
                                     GroupName="Detection" Checked="Detection_Checked" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
