<ui:FluentWindow x:Class="TeamsCompanion.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="OpenCompanion" Width="480" Height="570"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="OpenCompanion" />

        <ui:Card Grid.Row="1" Margin="16,8,16,0">
            <StackPanel>
                <ui:TextBlock Text="Compagnons" FontTypography="BodyStrong" Margin="0,0,0,8" />
                <ui:ListView x:Name="Companions" SelectionChanged="Companion_Changed">
                    <ui:ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ui:ListView.ItemsPanel>
                    <ui:ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding Requirement}" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Tile" CornerRadius="6" BorderThickness="2" Padding="4"
                                                BorderBrush="Transparent" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Tile" Property="Opacity" Value="0.35" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ui:ListView.ItemContainerStyle>
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="88" Margin="4">
                                <Image Source="{Binding Image}" Width="64" Height="64"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="2" Margin="16,8,16,0">
            <StackPanel>
                <ui:TextBlock Text="Détection du statut" FontTypography="BodyStrong" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DetectClient" Content="Logs client" GroupName="Detection" IsChecked="True" Margin="0,0,24,0"
                                 Checked="Detection_Checked" />
                    <RadioButton x:Name="DetectGraph" Content="API Graph" GroupName="Detection" Checked="Detection_Checked" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="3" Margin="16,8,16,0">
            <StackPanel>
                <ui:TextBlock Text="Écran" FontTypography="BodyStrong" Margin="0,0,0,8" />
                <ui:InfoBar x:Name="Device" IsOpen="True" IsClosable="False" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button x:Name="UpdateButton" Appearance="Primary" Margin="0,0,8,0"
                               Visibility="Collapsed" Click="Update_Click" />
                    <ui:Button x:Name="FileButton" Content="Installer depuis un fichier…"
                               Visibility="Collapsed" Click="File_Click" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="4" Margin="16,8,16,16">
            <StackPanel>
                <ui:TextBlock Text="Langue de l'écran" FontTypography="BodyStrong" Margin="0,0,0,8" />
                <ComboBox x:Name="LangBox" Width="200" HorizontalAlignment="Left"
                          DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectionChanged="Lang_Changed" />
            </StackPanel>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
