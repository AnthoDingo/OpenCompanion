<Page x:Class="TeamsCompanion.CompanionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:TeamsCompanion">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">
            <ui:TextBlock Text="{Binding [NavCompanions], Source={x:Static local:Tr.I}}" FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBlock Text="{Binding [CompanionsHint], Source={x:Static local:Tr.I}}" Margin="0,4,0,16"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Grille de tuiles : WrapPanel, autant de colonnes que la largeur le permet. -->
            <!-- Pas de défilement horizontal : sinon le WrapPanel a une largeur infinie et ne passe jamais à la ligne. -->
            <ui:ListView x:Name="Companions" SelectionChanged="Companion_Changed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ui:ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ui:ListView.ItemsPanel>
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="ToolTip" Value="{Binding Requirement}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Tile" CornerRadius="8" BorderThickness="2" Padding="12"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Tile" Property="Opacity" Value="0.35" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:ListView.ItemContainerStyle>
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="112">
                            <Image Source="{Binding Image}" Width="96" Height="96"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <ui:TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
