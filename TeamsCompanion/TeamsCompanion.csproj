<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- uniquement pour NotifyIcon (icône de la zone de notification), absent de WPF -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Pousse en violet Teams, 16 à 256 px ; les fenêtres WPF reprennent l'icône de l'exe -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- version des builds hors tag ; un tag vX.Y.Z la remplace en CI (app.yml) -->
    <Version>1.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- évite les conflits de noms WPF / WinForms (Application, Color...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\sprites\**\*.png" Link="sprites\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <!-- mise à jour du firmware : touche 1200 bauds + liste des ports COM -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- mode Graph : connexion Teams via Microsoft Graph (client public MS, scope Presence.Read) -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
  </ItemGroup>

</Project>
